{
  "name": "mie-bara-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "db:food-options": "node --env-file-if-exists=.env src/scripts/sync-food-options.js",
    "db:note-only": "node --env-file-if-exists=.env src/scripts/note-only-categories.js",
    "staff:create": "node --env-file-if-exists=.env src/scripts/create-staff.js",
    "dev:test": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.test src/server.js",
    "db:test:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.test src/scripts/setup-test-db.js",
    "staff:create:test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test src/scripts/create-staff.js",
    "test": "node --test test/unit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.0"
  }
}
