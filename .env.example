PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kopi_miebara

# Dashboard staf: rahasia JWT (minimal 32 karakter, buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
# true hanya jika diakses lewat https; false untuk http lokal/LAN
COOKIE_SECURE=false

# Batas pesanan pelanggan per IP per 10 menit (0 = tanpa batas)
ORDER_RATE_LIMIT=100
# Maksimal pesanan pelanggan yang belum selesai/dibatalkan per meja hari ini (0 = tanpa batas).
# Pesanan yang diinput kasir tidak terkena batas ini.
MAX_ACTIVE_ORDERS_PER_TABLE=5
# Proxy yang dipercaya untuk X-Forwarded-For: loopback (default, proxy di mesin yang sama), angka
# jumlah hop, daftar IP/subnet, true, atau false. Lihat dokumentasi 'trust proxy' Express.
TRUST_PROXY=loopback
# Jumlah meja (QR dan validasi nomor meja 1..TABLE_COUNT)
TABLE_COUNT=10
# Nomor HP pesanan dikosongkan setelah N hari oleh: npm run db:retention (default 90)
PHONE_RETENTION_DAYS=90
